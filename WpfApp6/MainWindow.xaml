<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snow 3D" Height="450" Width="600"
        Loaded="Window_Loaded">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="#0B1020" Offset="0"/>
                <GradientStop Color="#1E2A44" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Viewport3D>

            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,2,6"
                   LookDirection="0,-0.5,-1"
                   FieldOfView="60"/>
            </Viewport3D.Camera>

            <Viewport3D.Children>

                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="White" Direction="-1,-1,-2"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <ModelVisual3D x:Name="SnowContainer"/>

            </Viewport3D.Children>
            
        </Viewport3D>
        
        

        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="10">

            <Button Content="Start"
        Width="100"
        Margin="5"
        Click="Start_Click"/>

            <Button Content="Stop"
        Width="100"
        Margin="5"
        Click="Stop_Click"/>

        </StackPanel>

    </Grid>
</Window>